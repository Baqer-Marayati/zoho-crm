.DS_Store
**/.DS_Store

# Local-only heavy clones (e.g. upstream SDK or sample repos) — do not re-add
_reference/
_build/
.cache/

# Secrets — never commit
.env
**/.env
!**/.env.example
**/.token_cache.json
**/*.token.json
tools/zoho/.token*
*.pem
