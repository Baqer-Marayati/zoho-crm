did = dealId.toLong();
deal = zoho.crm.getRecordById("Deals", did);
if(deal == null)
{
	return;
}
stage = ifnull(deal.get("Stage"), "").toString();
missing = list();
discoverySummary = ifnull(deal.get("Discovery_summary"), "").toString().trim();
currentMachines = ifnull(deal.get("Current_machines_setup"), "").toString().trim();
applications = ifnull(deal.get("Applications"), "").toString().trim();
budgetStatus = ifnull(deal.get("Budget_financing_status"), "").toString().trim();
discoveryIncomplete = false;
if(discoverySummary == "" || currentMachines == "" || applications == "" || budgetStatus == "" || budgetStatus == "-None-")
{
	discoveryIncomplete = true;
}
if(stage == "Needs Analysis")
{
	subject = "Complete discovery on Deal - Needs Analysis";
	description = "Complete these discovery fields while the Deal is in Needs Analysis:\n";
	description = description + "- Discovery summary (Discovery_summary)\n";
	description = description + "- Current machines / setup (Current_machines_setup)\n";
	description = description + "- Applications (Applications)\n";
	description = description + "- Budget / financing status (Budget_financing_status)\n";
	description = description + "Budget / financing status must be selected from the picklist, not entered as prose.\n";
	description = description + "Proposal / Quote is blocked until these fields are complete.";
	keptTask = false;
	relatedTasks = zoho.crm.getRelatedRecords("Tasks", "Deals", did);
	if(relatedTasks != null && relatedTasks.size() > 0)
	{
		for each task in relatedTasks
		{
			taskSubject = ifnull(task.get("Subject"), "").toString();
			taskStatus = ifnull(task.get("Status"), "").toString();
			if((taskSubject == subject || taskSubject == "Complete discovery fields on Deal") && taskStatus != "Completed" && taskStatus != "Closed")
			{
				taskId = task.get("id");
				taskUpd = Map();
				if(!keptTask)
				{
					taskUpd.put("Subject", subject);
					taskUpd.put("Due_Date", zoho.currentdate.addDay(3).toString("yyyy-MM-dd"));
					taskUpd.put("Status", "Not Started");
					taskUpd.put("Priority", "Normal");
					taskUpd.put("Description", description);
					keptTask = true;
				}
				else
				{
					taskUpd.put("Status", "Completed");
					taskUpd.put("Description", "Closed duplicate Needs Analysis discovery task; the active checklist task remains on this Deal.");
				}
				if(taskId != null)
				{
					taskResp = zoho.crm.updateRecord("Tasks", taskId.toLong(), taskUpd);
				}
			}
		}
	}
	return;
}
if(stage == "Proposal / Quote")
{
	if(discoverySummary == "")
	{
		missing.add("Discovery summary");
	}
	if(currentMachines == "")
	{
		missing.add("Current machines / setup");
	}
	if(applications == "")
	{
		missing.add("Applications");
	}
	if(budgetStatus == "" || budgetStatus == "-None-")
	{
		missing.add("Budget / financing status");
	}
	amount = deal.get("Amount");
	if(amount == null || amount.toString().trim() == "")
	{
		missing.add("Amount");
	}
	if(deal.get("Primary_Quote") == null)
	{
		missing.add("Primary Quote");
	}
	linkedQuotes = zoho.crm.getRelatedRecords("Quotes", "Deals", did);
	if(linkedQuotes == null || linkedQuotes.size() == 0)
	{
		missing.add("at least one linked Quote");
	}
}
if(stage == "Negotiation")
{
	anyShared = deal.get("Any_quote_shared_with_customer");
	if(!(anyShared == true || anyShared == "true"))
	{
		missing.add("at least one linked Quote marked Quote shared with customer");
	}
}
if(stage == "Closed Won")
{
	wonNotes = ifnull(deal.get("Won_handoff_notes"), "").toString().trim();
	if(wonNotes == "")
	{
		missing.add("Won / handoff notes");
	}
}
if(stage == "Closed Lost")
{
	lostReason = ifnull(deal.get("Lost_Reason"), "").toString().trim();
	if(lostReason == "" || lostReason == "-None-")
	{
		missing.add("Lost Reason");
	}
	compRequired = false;
	if(lostReason == "Competitor" || lostReason == "Lost to competitor / bought elsewhere" || lostReason == "Price")
	{
		compRequired = true;
	}
	competitor = ifnull(deal.get("Competitor"), "").toString().trim();
	if(compRequired && (competitor == "" || competitor == "-None-"))
	{
		missing.add("Competitor");
	}
	nextTryRequired = false;
	if(lostReason == "Timing" || lostReason == "Timing / not now" || lostReason == "Budget" || lostReason == "No budget / no approval" || lostReason == "No decision" || lostReason == "Project paused" || lostReason == "Tender lost but future opportunities")
	{
		nextTryRequired = true;
	}
	if(nextTryRequired && deal.get("Next_try_follow_up_date") == null)
	{
		missing.add("Next try / follow-up date");
	}
}
if(missing.size() == 0)
{
	return;
}
message = "Stage gate failed for " + stage + ". Missing: " + missing.toString();
fallback = "";
if(stage == "Proposal / Quote")
{
	if(discoveryIncomplete)
	{
		fallback = "Needs Analysis";
	}
}
else if(stage == "Negotiation")
{
	fallback = "Proposal / Quote";
}
else if(stage == "Closed Won")
{
	fallback = "Negotiation";
}
if(fallback != "")
{
	upd = Map();
	upd.put("Stage", fallback);
	opt = Map();
	opt.put("trigger", list());
	resp = zoho.crm.updateRecord("Deals", did, upd, opt);
	message = message + ". Stage was moved back to " + fallback + ".";
}
taskMap = Map();
taskMap.put("Subject", "Fix Deal stage gate: " + stage);
taskMap.put("Due_Date", zoho.currentdate.toString("yyyy-MM-dd"));
taskMap.put("Status", "Not Started");
taskMap.put("Priority", "High");
taskMap.put("Description", message);
owner = deal.get("Owner");
if(owner != null && owner.get("id") != null)
{
	taskMap.put("Owner", owner.get("id"));
}
taskMap.put("$se_module", "Deals");
taskMap.put("What_Id", did);
taskResp = zoho.crm.createRecord("Tasks", taskMap);
return;
